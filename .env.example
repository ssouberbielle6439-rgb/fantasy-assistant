# Copy this file to ".env" and fill in your values.
# .env is ignored by Git, so your key never reaches GitHub.
SLEEPER_USERNAME=your-sleeper-username
SLEEPER_LEAGUE_ID=your-league-id
GEMINI_API_KEY=paste-your-key-here
# Optional: the Gemini model the chat uses. Leave it out for the default,
# gemini-3.5-flash-lite (stable, free tier).
# GEMINI_MODEL=gemini-3.5-flash-lite
# Your target for a lock. Locks below it are labeled, not blocked; the hard
# floor is 23 (20 on Sunday) and lives in lineup.py.
LOCK_TARGET_POINTS=25
# Optional: where lock files and the advice log are saved (relative paths count
# from the project folder). Leave it out to keep them in data/. Caches always
# stay in data/.
# STATE_DIR=notes/state
